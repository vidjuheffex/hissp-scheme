(import (scheme base)
        (scheme write)
        (srfi 64))

(define (written value)
  (let ((port (open-output-string)))
    (write value port)
    (get-output-string port)))

(test-group "bytevectors"
  (define bv (bytevector 1 2 3))
  (test-assert "bytevector?" (bytevector? bv))
  (test-equal "bytevector? vector" #f (bytevector? (vector 1 2)))
  (test-equal "vector? bytevector" #f (vector? bv))
  (test-equal "bytevector-length" 3 (bytevector-length bv))
  (test-equal "bytevector-u8-ref" 2 (bytevector-u8-ref bv 1))
  (bytevector-u8-set! bv 1 200)
  (test-equal "bytevector-u8-set!" 200 (bytevector-u8-ref bv 1))
  (test-error "bytevector-u8-ref range" IndexError (bytevector-u8-ref bv 3))
  (test-error "bytevector-u8-set! byte" TypeError (bytevector-u8-set! bv 0 256))
  (test-error "bytevector byte" TypeError (bytevector 1 -1))
  (test-equal "make-bytevector" (bytevector 7 7) (make-bytevector 2 7))
  (test-equal "make-bytevector default" (bytevector 0 0 0) (make-bytevector 3))
  (test-equal "bytevector empty" 0 (bytevector-length (bytevector)))
  (test-equal "bytevector-copy" (bytevector 200 3) (bytevector-copy bv 1))
  (test-equal "bytevector-copy range" (bytevector 200) (bytevector-copy bv 1 2))
  (define copy (bytevector-copy bv))
  (bytevector-u8-set! copy 0 99)
  (test-equal "bytevector-copy is fresh" 1 (bytevector-u8-ref bv 0))
  (define target (make-bytevector 5 0))
  (bytevector-copy! target 1 (bytevector 9 8 7))
  (test-equal "bytevector-copy!" (bytevector 0 9 8 7 0) target)
  (bytevector-copy! target 0 (bytevector 1 2 3 4) 2 4)
  (test-equal "bytevector-copy! range" (bytevector 3 4 8 7 0) target)
  (test-error "bytevector-copy! overflow" IndexError
              (bytevector-copy! (make-bytevector 2) 1 (bytevector 1 2)))
  (test-equal "bytevector-append" (bytevector 1 2 3)
              (bytevector-append (bytevector 1) (bytevector) (bytevector 2 3)))
  (test-equal "bytevector-append none" (bytevector) (bytevector-append))
  (test-assert "equal?" (equal? (bytevector 1 2) (bytevector 1 2)))
  (test-equal "equal? different" #f (equal? (bytevector 1 2) (bytevector 1 3)))
  (test-equal "eqv? distinct" #f (eqv? (bytevector 1) (bytevector 1)))
  (test-equal "write" "#u8(1 200 3)" (written bv)))

(test-group "utf-8 conversion"
  (test-equal "utf8->string" "hi" (utf8->string (bytevector 104 105)))
  (test-equal "utf8->string range" "i" (utf8->string (bytevector 104 105) 1))
  (test-equal "string->utf8" (bytevector 206 187) (string->utf8 "λ"))
  (test-equal "string->utf8 range" (bytevector 98) (string->utf8 "abc" 1 2))
  (test-equal "round trip" "héllo" (utf8->string (string->utf8 "héllo"))))

(test-group "bytevector ports"
  (define in (open-input-bytevector (bytevector 10 20 30 40 50)))
  (test-assert "binary-port?" (binary-port? in))
  (test-equal "textual-port?" #f (textual-port? in))
  (test-assert "input-port?" (input-port? in))
  (test-equal "peek-u8" 10 (peek-u8 in))
  (test-equal "read-u8" 10 (read-u8 in))
  (test-equal "read-bytevector" (bytevector 20 30) (read-bytevector 2 in))
  (test-assert "u8-ready?" (u8-ready? in))
  (define buffer (make-bytevector 4 0))
  (test-equal "read-bytevector! count" 2 (read-bytevector! buffer in 1))
  (test-equal "read-bytevector! contents" (bytevector 0 40 50 0) buffer)
  (test-assert "read-u8 eof" (eof-object? (read-u8 in)))
  (test-assert "peek-u8 eof" (eof-object? (peek-u8 in)))
  (test-assert "read-bytevector eof" (eof-object? (read-bytevector 3 in)))
  (test-assert "read-bytevector! eof" (eof-object? (read-bytevector! buffer in)))
  (test-equal "read-bytevector zero" (bytevector) (read-bytevector 0 in))

  (define out (open-output-bytevector))
  (test-assert "output-port?" (output-port? out))
  (write-u8 65 out)
  (write-bytevector (bytevector 66 67 68) out 1)
  (write-bytevector (bytevector 69 70 71) out 0 1)
  (test-equal "get-output-bytevector" (bytevector 65 67 68 69) (get-output-bytevector out))
  (test-error "write-u8 byte" TypeError (write-u8 300 out))
  (test-error "binary read from textual port" TypeError
              (read-u8 (open-input-string "abc")))
  (test-error "textual read from binary port" TypeError
              (write-string "x" (open-input-bytevector (bytevector)))))

(test-group "vector and bytevector literals"
  (test-equal "vector literal" (vector 1 'a "s") #(1 a "s"))
  (test-assert "vector literal is a vector" (vector? #(1 2)))
  (test-equal "empty vector literal" (vector) #())
  (test-equal "nested vector literal" (vector (vector 1) '(2 3)) #(#(1) (2 3)))
  (test-equal "vector literal in quoted list" (list 1 (vector 2 'x))
              '(1 #(2 x)))
  (test-equal "vector-ref on literal" 20 (vector-ref #(10 20) 1))
  (test-equal "bytevector literal" (bytevector 1 2 255) #u8(1 2 255))
  (test-assert "bytevector literal is a bytevector" (bytevector? #u8()))
  (test-equal "bytevector literal in quoted list" (list (bytevector 3))
              '(#u8(3)))
  (define x 2)
  (define xs '(3 4))
  (test-equal "quasiquoted vector" (vector 'a 2 3 4) `#(a ,x ,@xs))
  (test-equal "vector inside quasiquote" (list 1 (vector 2)) `(1 #(,x)))
  (test-equal "write vector literal" "#(1 #(2) \"s\")" (written #(1 #(2) "s"))))
